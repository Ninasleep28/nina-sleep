{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "auth.html", "use": "@vercel/static" },
    { "src": "quiz.html", "use": "@vercel/static" },
    { "src": "payment.html", "use": "@vercel/static" },
    { "src": "success.html", "use": "@vercel/static" },
    { "src": "terms.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "accessibility.html", "use": "@vercel/static" },
    { "src": "blog.html", "use": "@vercel/static" },
    { "src": "blog-1.html", "use": "@vercel/static" },
    { "src": "blog-2.html", "use": "@vercel/static" },
    { "src": "blog-3.html", "use": "@vercel/static" },
    { "src": "blog-4.html", "use": "@vercel/static" },
    { "src": "blog-5.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/cron/send-notifications", "dest": "/server.js" },
    { "src": "/start-free", "dest": "/server.js" },
    { "src": "/webhook", "dest": "/server.js" },
    { "src": "/config", "dest": "/server.js" },
    { "src": "/stripe-checkout", "dest": "/server.js" },
    { "src": "/save-user", "dest": "/server.js" },
    { "src": "/stripe-webhook", "dest": "/server.js" },
    { "src": "/status", "dest": "/server.js" },
    { "src": "/reset/(.*)", "dest": "/server.js" },
    { "src": "/auth.html", "dest": "/auth.html" },
    { "src": "/quiz", "dest": "/quiz.html" },
    { "src": "/quiz.html", "dest": "/quiz.html" },
    { "src": "/payment.html", "dest": "/payment.html" },
    { "src": "/success.html", "dest": "/success.html" },
    { "src": "/terms.html", "dest": "/terms.html" },
    { "src": "/privacy.html", "dest": "/privacy.html" },
    { "src": "/accessibility.html", "dest": "/accessibility.html" },
    { "src": "/blog.html", "dest": "/blog.html" },
    { "src": "/blog-1.html", "dest": "/blog-1.html" },
    { "src": "/blog-2.html", "dest": "/blog-2.html" },
    { "src": "/blog-3.html", "dest": "/blog-3.html" },
    { "src": "/blog-4.html", "dest": "/blog-4.html" },
    { "src": "/blog-5.html", "dest": "/blog-5.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}